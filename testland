<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Нейросети и профессии будущего — гайд для родителей подростков 10–14 лет | Зерокодер</title>
<meta name="description" content="Бесплатный авторский гайд от Зерокодер: какие профессии исчезнут к 2030 году, а какие будут востребованы. На основе данных World Economic Forum.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* === tokens.css === */
/**
 * ============================================================
 * DESIGN TOKENS — top107 Design System
 * Based on UntitledUI PRO v8.0 + custom brand
 * ============================================================
 *
 * Usage: import this file first, then components.css
 * <link rel="stylesheet" href="tokens.css">
 * <link rel="stylesheet" href="components.css">
 */

:root {

  /* ── Brand (Purple) ──────────────────────────────────────── */
  --brand-50:  #F9F5FF;
  --brand-100: #F4EBFF;
  --brand-200: #E9D7FE;
  --brand-300: #D6BBFB;
  --brand-400: #B692F6;
  --brand-500: #9E77ED;
  --brand-600: #7F56D9;   /* ← primary action */
  --brand-700: #6941C6;   /* ← hover */
  --brand-800: #53389E;
  --brand-900: #42307D;

  /* ── Neutral ─────────────────────────────────────────────── */
  --neutral-0:   #FFFFFF;
  --neutral-50:  #FAFAFA;
  --neutral-100: #F5F5F5;
  --neutral-200: #E5E5E5;
  --neutral-300: #D4D4D4;
  --neutral-400: #A3A3A3;
  --neutral-500: #737373;
  --neutral-600: #525252;
  --neutral-700: #404040;
  --neutral-900: #171717;
  --neutral-950: #0A0A0A;

  /* ── Semantic ────────────────────────────────────────────── */
  --color-success:      #16A34A;
  --color-success-bg:   #F0FDF4;
  --color-success-border: #BBF7D0;

  --color-warning:      #CA8A04;   /* Yellow-600 — NOT orange */
  --color-warning-bg:   #FEFCE8;
  --color-warning-border: #FEF08A;

  --color-error:        #DC2626;
  --color-error-bg:     #FEF2F2;
  --color-error-border: #FECACA;

  --color-info:         #0369A1;
  --color-info-bg:      #F0F9FF;
  --color-info-border:  #BAE6FD;

  /* ── Typography ──────────────────────────────────────────── */
  --font-family:    'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
  --font-size-xs:   11px;
  --font-size-sm:   13px;
  --font-size-md:   15px;
  --font-size-base: 16px;
  --font-size-lg:   18px;
  --font-size-xl:   20px;
  --font-size-2xl:  24px;
  --font-size-3xl:  30px;
  --font-size-4xl:  36px;
  --font-size-5xl:  48px;

  --font-weight-regular:   400;
  --font-weight-medium:    500;
  --font-weight-semibold:  600;
  --font-weight-bold:      700;
  --font-weight-extrabold: 800;

  --line-height-tight:   1.2;
  --line-height-snug:    1.35;
  --line-height-normal:  1.5;
  --line-height-relaxed: 1.65;
  --line-height-loose:   1.75;

  /* letter-spacing: всегда -0.02em на заголовках ≥30px */
  --tracking-tight:  -0.02em;
  --tracking-normal:  0em;
  --tracking-wide:    0.05em;   /* uppercase labels */

  /* ── Spacing (8pt grid) ──────────────────────────────────── */
  --space-1:  4px;
  --space-2:  8px;
  --space-3:  12px;
  --space-4:  16px;
  --space-5:  20px;
  --space-6:  24px;
  --space-8:  32px;
  --space-10: 40px;
  --space-12: 48px;
  --space-16: 64px;
  --space-20: 80px;

  /* ── Border radius ───────────────────────────────────────── */
  --radius-sm:   6px;    /* inputs, small tags */
  --radius-md:   8px;    /* buttons, badges */
  --radius-lg:   12px;   /* cards */
  --radius-xl:   16px;   /* large blocks */
  --radius-2xl:  24px;   /* hero blocks */
  --radius-pill: 9999px; /* pills, tags */

  /* ── Shadows (multi-layer — NEVER single layer) ──────────── */
  --shadow-xs:
    0px 1px 2px rgba(0, 0, 0, 0.05);

  --shadow-sm:
    0px 1px 2px -1px rgba(0, 0, 0, 0.10),
    0px 1px 3px rgba(0, 0, 0, 0.10);

  --shadow-md:
    0px 2px 4px -2px rgba(0, 0, 0, 0.06),
    0px 4px 6px -1px rgba(0, 0, 0, 0.10);

  --shadow-lg:
    0px 2px 2px -1px rgba(0, 0, 0, 0.04),
    0px 4px 6px -2px rgba(0, 0, 0, 0.03),
    0px 12px 16px -4px rgba(0, 0, 0, 0.08);

  --shadow-xl:
    0px 4px 6px -2px rgba(0, 0, 0, 0.03),
    0px 8px 8px -4px rgba(0, 0, 0, 0.03),
    0px 20px 24px -4px rgba(0, 0, 0, 0.08);

  --shadow-btn:
    0px 1px 2px rgba(0, 0, 0, 0.05),
    0px -2px 0px 0px rgba(0, 0, 0, 0.05) inset,
    0px 0px 0px 1px rgba(0, 0, 0, 0.18) inset;

  /* ── Focus ring ──────────────────────────────────────────── */
  --focus-ring:
    0px 0px 0px 4px var(--brand-500),
    0px 0px 0px 2px white;

  /* ── Z-index ─────────────────────────────────────────────── */
  --z-sticky:  100;
  --z-overlay: 200;
  --z-modal:   300;
  --z-toast:   400;

  /* ── Layout ──────────────────────────────────────────────── */
  --container-max:    1280px;
  --container-pad:    80px;   /* desktop */
  --container-pad-md: 32px;   /* tablet  */
  --container-pad-sm: 16px;   /* mobile  */

  --header-height: 64px;
  --sidebar-width: 300px;
}

/* ── Reset ───────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }

body {
  font-family:             var(--font-family);
  font-size:               var(--font-size-base);
  font-weight:             var(--font-weight-regular);
  line-height:             var(--line-height-normal);
  color:                   var(--neutral-900);
  -webkit-font-smoothing:  antialiased;
  margin: 0;
}

/* ── Focus ring ──────────────────────────────────────────────── */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: none;
  box-shadow: var(--focus-ring);
  border-radius: var(--radius-sm);
}

/* === components.css === */
/**
 * ============================================================
 * COMPONENTS — top107 Design System
 * Requires: tokens.css
 * ============================================================
 */

/* ── Container ───────────────────────────────────────────────── */
.t107-container {
  max-width: var(--container-max);
  margin:    0 auto;
  padding:   0 var(--container-pad);
}
@media (max-width: 1024px) { .t107-container { padding: 0 var(--container-pad-md); } }
@media (max-width: 768px)  { .t107-container { padding: 0 var(--container-pad-sm); } }

/* ══════════════════════════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════════════════════════ */

.btn {
  display:         inline-flex;
  align-items:     center;
  justify-content: center;
  gap:             8px;
  font-family:     var(--font-family);
  font-weight:     var(--font-weight-semibold);
  border:          none;
  border-radius:   var(--radius-md);
  cursor:          pointer;
  text-decoration: none;
  white-space:     nowrap;
  transition:      background 0.15s ease, color 0.15s ease, transform 0.1s ease;
  line-height:     1.25;
}

/* Sizes */
.btn-sm  { height: 36px; padding: 8px 14px;  font-size: 14px; }
.btn-md  { height: 40px; padding: 10px 16px; font-size: 15px; }
.btn-lg  { height: 44px; padding: 10px 18px; font-size: 16px; }
.btn-xl  { height: 48px; padding: 12px 20px; font-size: 16px; }
.btn-2xl { height: 56px; padding: 14px 28px; font-size: 18px; }

/* Primary */
.btn-primary {
  background:  var(--brand-600);
  color:       #FFFFFF;
  box-shadow:  var(--shadow-btn);
}
.btn-primary:hover { background: var(--brand-700); color: #FFFFFF; }
.btn-primary:active { transform: translateY(1px); }

/* Secondary (outlined brand) */
.btn-secondary {
  background:  #FFFFFF;
  color:       var(--brand-700);
  border:      1px solid var(--brand-300);
  box-shadow:  var(--shadow-xs);
}
.btn-secondary:hover { background: var(--brand-50); border-color: var(--brand-400); }

/* Ghost (neutral outlined) */
.btn-ghost {
  background:  #FFFFFF;
  color:       var(--neutral-700);
  border:      1px solid var(--neutral-200);
  box-shadow:  var(--shadow-xs);
}
.btn-ghost:hover { background: var(--neutral-50); border-color: var(--neutral-300); }

/* Destructive */
.btn-danger {
  background:  var(--color-error);
  color:       #FFFFFF;
  box-shadow:  var(--shadow-btn);
}
.btn-danger:hover { background: #B91C1C; }

/* Icon-only */
.btn-icon { padding: 0; width: 40px; }
.btn-icon.btn-sm  { width: 36px; }
.btn-icon.btn-lg  { width: 44px; }

/* ══════════════════════════════════════════════════════════════
   BADGES / TAGS
══════════════════════════════════════════════════════════════ */

.badge {
  display:      inline-flex;
  align-items:  center;
  gap:          4px;
  padding:      3px 10px;
  border-radius: var(--radius-pill);
  font-size:    var(--font-size-xs);
  font-weight:  var(--font-weight-medium);
  border:       1px solid;
  line-height:  1.4;
  white-space:  nowrap;
}

.badge-brand   { color: var(--brand-700);         background: var(--brand-100);         border-color: var(--brand-200); }
.badge-success { color: var(--color-success);     background: var(--color-success-bg);  border-color: var(--color-success-border); }
.badge-warning { color: var(--color-warning);     background: var(--color-warning-bg);  border-color: var(--color-warning-border); }
.badge-error   { color: var(--color-error);       background: var(--color-error-bg);    border-color: var(--color-error-border); }
.badge-info    { color: var(--color-info);        background: var(--color-info-bg);     border-color: var(--color-info-border); }
.badge-neutral { color: var(--neutral-600);       background: var(--neutral-100);       border-color: var(--neutral-200); }

/* Pricing badges (used in service cards) */
.badge-price   { color: var(--color-success);  background: var(--color-success-bg); border-color: var(--color-success-border); }
.badge-free    { color: var(--color-info);     background: var(--color-info-bg);    border-color: var(--color-info-border); }
.badge-trial   { color: var(--color-warning);  background: var(--color-warning-bg); border-color: var(--color-warning-border); }
.badge-feature { color: var(--brand-700);      background: var(--brand-50);         border-color: var(--brand-200); }

/* ══════════════════════════════════════════════════════════════
   CARDS
══════════════════════════════════════════════════════════════ */

.card {
  background:    #FFFFFF;
  border:        1px solid var(--neutral-200);
  border-radius: var(--radius-lg);
  box-shadow:    var(--shadow-sm);
  transition:    box-shadow 0.2s ease, border-color 0.2s ease;
}
.card:hover {
  box-shadow:   var(--shadow-md);
  border-color: var(--neutral-300);
}

.card-body    { padding: var(--space-5); }
.card-body-lg { padding: var(--space-6); }

/* Service card (toplist item) */
.service-card {
  border:        1px solid var(--neutral-200);
  border-radius: var(--radius-lg);
  padding:       var(--space-6);
  margin:        var(--space-8) 0;
  background:    #FFFFFF;
  box-shadow:    var(--shadow-sm);
  transition:    box-shadow 0.2s ease, border-color 0.2s ease;
}
.service-card:hover {
  box-shadow:   var(--shadow-md);
  border-color: var(--brand-200);
}
.service-card h2,
.service-card h3 {
  font-size:      18px !important;
  font-weight:    700 !important;
  color:          var(--neutral-900) !important;
  margin:         0 0 12px !important;
  padding:        0 !important;
  border:         none !important;
  letter-spacing: var(--tracking-tight) !important;
}
.service-card__meta {
  display:       flex;
  flex-wrap:     wrap;
  gap:           8px;
  margin-bottom: 14px;
}
.service-card__pros-cons {
  display:       grid;
  grid-template-columns: 1fr 1fr;
  gap:           16px;
  margin-top:    16px;
  padding-top:   16px;
  border-top:    1px solid var(--neutral-100);
}
@media (max-width: 600px) {
  .service-card__pros-cons { grid-template-columns: 1fr; }
}
.service-card__pros h4,
.service-card__cons h4 {
  font-size:      12px !important;
  font-weight:    600 !important;
  text-transform: uppercase !important;
  letter-spacing: var(--tracking-wide) !important;
  margin:         0 0 8px !important;
  padding:        0 !important;
  border:         none !important;
}
.service-card__pros h4 { color: var(--color-success) !important; }
.service-card__cons h4 { color: var(--color-error) !important; }
.service-card__pros ul,
.service-card__cons ul { list-style: none; padding: 0; margin: 0; }
.service-card__pros li,
.service-card__cons li {
  font-size:   14px;
  color:       var(--neutral-600);
  padding:     3px 0;
  display:     flex;
  align-items: baseline;
  gap:         6px;
}
.service-card__pros li::before { content: '+'; color: var(--color-success); font-weight: 700; }
.service-card__cons li::before { content: '−'; color: var(--color-error);   font-weight: 700; }

/* ══════════════════════════════════════════════════════════════
   ARTICLE CONTENT TYPOGRAPHY
══════════════════════════════════════════════════════════════ */

.article-content {
  font-size:   16px;
  line-height: var(--line-height-loose);
  color:       var(--neutral-700);
}
.article-content h2 {
  font-size:      22px;
  font-weight:    700;
  color:          var(--neutral-900);
  margin:         2.5rem 0 1rem;
  padding-bottom: 0.5rem;
  border-bottom:  2px solid var(--neutral-100);
  letter-spacing: var(--tracking-tight);
}
.article-content h3 {
  font-size:      18px;
  font-weight:    600;
  color:          var(--neutral-900);
  margin:         1.75rem 0 0.75rem;
  letter-spacing: -0.01em;
}
.article-content p  { margin: 0 0 1.25rem; }
.article-content a  { color: var(--brand-600); text-decoration: none; }
.article-content a:hover { text-decoration: underline; color: var(--brand-700); }
.article-content strong  { color: var(--neutral-900); font-weight: 600; }
.article-content ul,
.article-content ol { margin: 0 0 1.25rem 1.25rem; padding: 0; }
.article-content li { margin-bottom: 0.4rem; }
.article-content blockquote {
  border-left:   3px solid var(--brand-600);
  margin:        1.5rem 0;
  padding:       0.75rem 1.25rem;
  background:    var(--brand-50);
  border-radius: 0 var(--radius-md) var(--radius-md) 0;
  color:         var(--brand-700);
  font-style:    italic;
}

/* ══════════════════════════════════════════════════════════════
   TABLES
══════════════════════════════════════════════════════════════ */

.article-content table,
.t107-table {
  width:           100%;
  border-collapse: collapse;
  font-size:       14px;
  overflow-x:      auto;
  display:         block;
  border-radius:   var(--radius-md);
  border:          1px solid var(--neutral-200);
  margin:          1.5rem 0;
}
.article-content thead th,
.t107-table thead th {
  background:    var(--neutral-50);
  text-align:    left;
  padding:       11px 16px;
  border-bottom: 1px solid var(--neutral-200);
  font-weight:   600;
  color:         var(--neutral-700);
  white-space:   nowrap;
  font-size:     13px;
}
.article-content tbody td,
.t107-table tbody td {
  padding:         10px 16px;
  border-bottom:   1px solid var(--neutral-100);
  vertical-align:  middle;
  color:           var(--neutral-600);
}
.article-content tbody tr:last-child td,
.t107-table tbody tr:last-child td { border-bottom: none; }
.article-content tbody tr:hover td,
.t107-table tbody tr:hover td { background: var(--neutral-50); }

/* ══════════════════════════════════════════════════════════════
   FORMS
══════════════════════════════════════════════════════════════ */

.form-group {
  display:        flex;
  flex-direction: column;
  gap:            6px;
}

.form-label {
  font-size:   14px;
  font-weight: var(--font-weight-medium);
  color:       var(--neutral-700);
}

.form-input,
.form-select,
.form-textarea {
  width:         100%;
  height:        44px;
  padding:       0 16px;
  font-family:   var(--font-family);
  font-size:     15px;
  color:         var(--neutral-900);
  background:    #FFFFFF;
  border:        1px solid var(--neutral-200);
  border-radius: var(--radius-md);
  outline:       none;
  transition:    border-color 0.15s ease, box-shadow 0.15s ease;
}
.form-textarea { height: auto; padding: 12px 16px; resize: vertical; }
.form-select   { appearance: none; cursor: pointer; }

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  border-color: var(--brand-600);
  box-shadow:   0 0 0 3px rgba(127, 86, 217, 0.12);
}
.form-input::placeholder,
.form-textarea::placeholder { color: var(--neutral-400); }

.form-hint  { font-size: 13px; color: var(--neutral-500); }
.form-error { font-size: 13px; color: var(--color-error); }

/* ══════════════════════════════════════════════════════════════
   BREADCRUMBS
══════════════════════════════════════════════════════════════ */

.breadcrumbs {
  display:     flex;
  align-items: center;
  flex-wrap:   wrap;
  gap:         4px;
  font-size:   13px;
  color:       var(--neutral-400);
  margin-bottom: 16px;
}
.breadcrumbs a    { color: var(--neutral-500); text-decoration: none; transition: color 0.15s; }
.breadcrumbs a:hover { color: var(--brand-600); }
.breadcrumbs .sep { color: var(--neutral-300); }

/* ══════════════════════════════════════════════════════════════
   PAGINATION
══════════════════════════════════════════════════════════════ */

.nav-links { display: flex; gap: 6px; flex-wrap: wrap; }
.nav-links a,
.nav-links span {
  display:         inline-flex;
  align-items:     center;
  justify-content: center;
  min-width:       36px;
  height:          36px;
  padding:         0 10px;
  border-radius:   var(--radius-md);
  font-size:       14px;
  font-weight:     500;
  border:          1px solid var(--neutral-200);
  color:           var(--neutral-700);
  text-decoration: none;
  transition:      all 0.15s ease;
}
.nav-links a:hover { border-color: var(--brand-600); color: var(--brand-600); background: var(--brand-50); }
.nav-links .current { background: var(--brand-600); color: #FFFFFF; border-color: var(--brand-600); }

/* ══════════════════════════════════════════════════════════════
   FAQ
══════════════════════════════════════════════════════════════ */

.faq-item {
  border:        1px solid var(--neutral-200);
  border-radius: var(--radius-md);
  margin-bottom: 8px;
  overflow:      hidden;
}
.faq-item summary {
  padding:         14px 18px;
  font-weight:     600;
  font-size:       15px;
  color:           var(--neutral-900);
  cursor:          pointer;
  list-style:      none;
  display:         flex;
  justify-content: space-between;
  align-items:     center;
  gap:             16px;
  user-select:     none;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::marker               { display: none; }
.faq-item summary:hover                 { background: var(--neutral-50); }
.faq-item[open] summary .faq-chevron    { transform: rotate(180deg); }
.faq-chevron { transition: transform 0.2s ease; flex-shrink: 0; color: var(--neutral-500); }
.faq-answer {
  padding:   0 18px 14px;
  font-size: 15px;
  color:     var(--neutral-600);
  line-height: 1.7;
}

/* ══════════════════════════════════════════════════════════════
   HEADER
══════════════════════════════════════════════════════════════ */

.t107-header {
  position:    sticky;
  top:         0;
  left:        0;
  right:       0;
  z-index:     var(--z-sticky);
  height:      var(--header-height);
  background:  rgba(255, 255, 255, 0.95);
  border-bottom: 1px solid transparent;
  transition:  border-color 0.2s ease, box-shadow 0.2s ease, backdrop-filter 0.2s ease;
}
.t107-header.scrolled {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  background:    rgba(255, 255, 255, 0.88);
  border-bottom-color: var(--neutral-200);
  box-shadow:    var(--shadow-sm);
}
.t107-header-inner {
  max-width:   var(--container-max);
  margin:      0 auto;
  padding:     0 32px;
  height:      100%;
  display:     flex;
  align-items: center;
  gap:         32px;
}
.t107-logo {
  font-size:       20px;
  font-weight:     800;
  color:           var(--brand-600);
  text-decoration: none;
  letter-spacing:  var(--tracking-tight);
  flex-shrink:     0;
}
.t107-logo:hover { color: var(--brand-700); }

.t107-nav {
  display:     flex;
  align-items: center;
  gap:         4px;
  list-style:  none;
  margin:      0;
  padding:     0;
  flex:        1;
}
.t107-nav a {
  display:         block;
  padding:         6px 12px;
  font-size:       14px;
  font-weight:     500;
  color:           var(--neutral-600);
  text-decoration: none;
  border-radius:   var(--radius-sm);
  transition:      color 0.15s ease, background 0.15s ease;
  white-space:     nowrap;
}
.t107-nav a:hover,
